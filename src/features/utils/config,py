"""Configuration loader: YAML file + environment-variable overrides + .env support."""
from __future__ import annotations

import copy
import os
from functools import lru_cache
from pathlib import Path
from typing import Any

import pandas as pd
import yaml

try:
    from dotenv import load_dotenv
except ImportError:  # python-dotenv is optional
    load_dotenv = None

PROJECT_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_CONFIG_PATH = PROJECT_ROOT / "configs" / "config.yaml"
ENV_PREFIX = "NCP_"
_RESERVED_ENV = {"NCP_CONFIG_PATH"}


def _apply_env_overrides(cfg: dict[str, Any]) -> dict[str, Any]:
    """NCP_SECTION__KEY=value overrides cfg['section']['key'] (YAML-typed)."""
    for env_key, raw in os.environ.items():
        if not env_key.startswith(ENV_PREFIX) or env_key in _RESERVED_ENV:
            continue
        parts = env_key[len(ENV_PREFIX):].lower().split("__")
        node = cfg
        for part in parts[:-1]:
            node = node.setdefault(part, {})
        node[parts[-1]] = yaml.safe_load(raw)  # "30" -> 30, "true" -> True
    return cfg


def load_config(path: str | os.PathLike | None = None) -> dict[str, Any]:
    """Load configuration (uncached). Use get_config() in application code."""
    if load_dotenv is not None:
        load_dotenv(PROJECT_ROOT / ".env", override=False)
    cfg_path = Path(path or os.environ.get("NCP_CONFIG_PATH") or DEFAULT_CONFIG_PATH)
    if not cfg_path.exists():
        raise FileNotFoundError(f"Config file not found: {cfg_path}")
    with open(cfg_path, "r", encoding="utf-8") as fh:
        cfg = yaml.safe_load(fh) or {}
    return _apply_env_overrides(copy.deepcopy(cfg))


@lru_cache(maxsize=1)
def _cached_config() -> dict[str, Any]:
    return load_config()


def get_config() -> dict[str, Any]:
    """Return a fresh copy of the cached config (safe to mutate)."""
    return copy.deepcopy(_cached_config())


def resolve_path(cfg: dict[str, Any], key: str) -> Path:
    """Resolve cfg['paths'][key] relative to the project root and create it."""
    p = Path(cfg["paths"][key])
    p = p if p.is_absolute() else PROJECT_ROOT / p
    p.mkdir(parents=True, exist_ok=True)
    return p


def horizon_steps(cfg: dict[str, Any]) -> int:
    """Prediction horizon expressed in sampling steps (e.g. 30 min / 5 min = 6)."""
    step = pd.Timedelta(cfg["data"]["sampling_freq"])
    horizon = pd.Timedelta(minutes=float(cfg["prediction"]["horizon_minutes"]))
    steps = horizon / step
    if steps < 1 or abs(steps - round(steps)) > 1e-9:
        raise ValueError(
            f"Horizon {horizon} must be a positive multiple of the sampling "
            f"interval {step}."
        )
    return int(round(steps))
